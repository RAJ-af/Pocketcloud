# Public client configuration only. Never put a service_role or secret API key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional TURN relay for networks where direct WebRTC peer connections fail.
TURN_URL=turn:YOUR_TURN_HOST:3478
TURN_USERNAME=YOUR_EPHEMERAL_TURN_USERNAME
TURN_CREDENTIAL=YOUR_EPHEMERAL_TURN_CREDENTIAL
